#version 460 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Crystal {
    vec4 positionHeight; // xyz = base position, w = current height
    vec4 params;         // x = radius, y = growth speed, z = initialized, w = target height
    vec4 color;
};

layout(std430, binding = 0) buffer CrystalBuffer {
    Crystal crystals[];
};

uniform float uDelta;
uniform float uTime;
uniform uint uCount;
uniform uint uSeed;
uniform int uDistribution;
uniform float uSpacing;
uniform float uJitter;
uniform float uSparsity;
uniform int uClusterCount;
uniform float uClusterRadius;
uniform float uSpiralTurns;

uniform float uMinRadius;
uniform float uMaxRadius;
uniform float uMinHeight;
uniform float uMaxHeight;
uniform float uHeightPower;
uniform float uGrowthMin;
uniform float uGrowthMax;
uniform float uGrowthMultiplier;
uniform float uPulseStrength;

uniform float uMineralScale;
uniform float uMineralWarp;
uniform float uMineralContrast;
uniform vec3 uPaletteA;
uniform vec3 uPaletteB;
uniform vec3 uPaletteC;
uniform float uThirdColorMix;
uniform float uColorVariation;

const float PI = 3.14159265358979323846;
const float GOLDEN_ANGLE = 2.39996322972865332;

uint hash(uint x) {
    x += x << 10u;
    x ^= x >> 6u;
    x += x << 3u;
    x ^= x >> 11u;
    x += x << 15u;
    return x;
}

uint seededHash(uint value, uint salt) {
    return hash(value ^ hash(uSeed + salt * 0x9E3779B9u));
}

float random01(uint value, uint salt) {
    return float(seededHash(value, salt)) / 4294967295.0;
}

vec2 placement(uint id, float r0, float r1) {
    uint side = uint(ceil(sqrt(float(max(uCount, 1u)))));
    float halfSide = float(max(side, 1u) - 1u) * 0.5;
    float fieldRadius = max(1.0, float(side) * uSpacing * 0.5);
    vec2 xz;

    if (uDistribution == 1) {
        // Sunflower / golden-angle disk.
        float t = (float(id) + 0.5) / float(max(uCount, 1u));
        float radius = sqrt(t) * fieldRadius;
        float angle = float(id) * GOLDEN_ANGLE + (r0 - 0.5) * uJitter;
        xz = vec2(cos(angle), sin(angle)) * radius;
    } else if (uDistribution == 2) {
        // Continuous mathematical spiral.
        float t = (float(id) + 0.5) / float(max(uCount, 1u));
        float radius = sqrt(t) * fieldRadius;
        float angle = t * max(1.0, uSpiralTurns) * 2.0 * PI;
        angle += (r0 - 0.5) * uJitter * 0.7;
        xz = vec2(cos(angle), sin(angle)) * radius;
    } else if (uDistribution == 3) {
        // Deterministic random clusters. Each crystal selects one seeded center.
        uint count = uint(max(uClusterCount, 1));
        uint cluster = seededHash(id, 401u) % count;
        float cx = random01(cluster, 409u) * 2.0 - 1.0;
        float cz = random01(cluster, 419u) * 2.0 - 1.0;
        vec2 center = vec2(cx, cz) * fieldRadius * 0.82;
        float localAngle = r0 * 2.0 * PI;
        float localRadius = sqrt(r1) * max(0.05, uClusterRadius);
        xz = center + vec2(cos(localAngle), sin(localAngle)) * localRadius;
    } else {
        // Jittered grid.
        uint gx = id % side;
        uint gz = id / side;
        xz = (vec2(float(gx), float(gz)) - halfSide) * uSpacing;
        xz += vec2(r0 - 0.5, r1 - 0.5) * uSpacing * uJitter;
    }

    // Small universal offset keeps even the radial modes from looking too perfect.
    vec2 micro = vec2(
        random01(id, 431u) - 0.5,
        random01(id, 433u) - 0.5
    );
    xz += micro * uSpacing * uJitter * 0.22;
    return xz;
}

float mineralField(vec2 xz) {
    float scale = max(0.001, uMineralScale);
    float seedPhase = float(uSeed & 65535u) * 0.00031;

    float warpX = sin(xz.y * scale * 0.83 + seedPhase) * uMineralWarp;
    float warpZ = cos(xz.x * scale * 0.71 - seedPhase * 1.37) * uMineralWarp;
    vec2 p = xz + vec2(warpX, warpZ);

    float bands = sin(p.x * scale + sin(p.y * scale * 0.91 + seedPhase));
    float rings = sin(length(p) * scale * 2.3 - seedPhase * 3.0);
    float cross = sin((p.x + p.y) * scale * 0.47 + seedPhase * 2.0);

    float field = 0.5 + 0.5 * (bands * 0.58 + rings * 0.27 + cross * 0.15);
    field = clamp((field - 0.5) * max(0.01, uMineralContrast) + 0.5, 0.0, 1.0);
    return field;
}

void initializeCrystal(uint id, inout Crystal c) {
    float r0 = random01(id, 11u);
    float r1 = random01(id, 37u);
    float r2 = random01(id, 71u);
    float r3 = random01(id, 101u);

    vec2 xz = placement(id, r0, r1);
    float mineral = mineralField(xz);
    float sparse = random01(id, 149u);

    float radiusNoise = r2 * r2;
    float radius = mix(max(0.001, uMinRadius), max(uMinRadius, uMaxRadius), radiusNoise);
    if (sparse < clamp(uSparsity, 0.0, 0.98)) {
        radius *= 0.015;
    }

    float shapedHeight = pow(max(r3, 0.0001), max(0.05, uHeightPower));
    float targetHeight = mix(max(0.01, uMinHeight), max(uMinHeight, uMaxHeight), shapedHeight);
    targetHeight *= mix(0.58, 1.62, mineral);

    float growthSpeed = mix(max(0.001, uGrowthMin), max(uGrowthMin, uGrowthMax), random01(id, 211u));

    vec3 color = mix(uPaletteA, uPaletteB, mineral);
    color = mix(color, uPaletteC, r1 * clamp(uThirdColorMix, 0.0, 1.0));
    float colorNoise = random01(id, 271u) - 0.5;
    color *= 1.0 + colorNoise * uColorVariation;
    color = clamp(color, vec3(0.0), vec3(2.0));

    c.positionHeight = vec4(xz.x, 0.0, xz.y, 0.025);
    c.params = vec4(radius, growthSpeed, 1.0, targetHeight);
    c.color = vec4(color, 1.0);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= uCount) {
        return;
    }

    Crystal c = crystals[id];
    if (c.params.z < 0.5) {
        initializeCrystal(id, c);
    }

    float phase = random01(id, 317u) * 2.0 * PI;
    float wave = 0.5 + 0.5 * sin(uTime * 0.65 + phase);
    float pulse = mix(1.0, wave, clamp(uPulseStrength, 0.0, 0.98));
    float remaining = max(0.0, c.params.w - c.positionHeight.w);
    float slowdown = smoothstep(0.0, 0.9, remaining);

    c.positionHeight.w += uDelta * c.params.y * max(0.0, uGrowthMultiplier)
                         * pulse * max(0.045, slowdown);
    c.positionHeight.w = min(c.positionHeight.w, c.params.w);

    crystals[id] = c;
}
